# Environment for test scripts that launch Docker services.
# Safe to commit — static test credentials only, never production secrets.
# Used by: run-integration-tests.sh, run-e2e-tests.sh, run-smoke-tests.sh,
# and start-deployment.sh (project tcp-*).
#
# The Zitadel bootstrap writes the REAL generated credentials
# (OIDC_CLIENT_ID/SECRET, TEST_CLIENT_ID/SECRET) to the gitignored
# .env.testing.local override, which layers on top of this file (local wins).
# TEST_CLIENT_* is api-tier-only and lives solely in .env.testing.local. The
# OIDC_CLIENT_* placeholders below are inert — they only satisfy config
# validation for the integration/e2e tiers (which never perform real OIDC); the
# api/smoke tier uses the real values from .env.testing.local.

# Database
DB_USER=tcp
DB_PASSWORD=dev-password
DB_NAME=tcp

# Exposed ports (testing uses different ports to avoid conflicts with dev)
EXPOSE_PORT_API=3001

# MinIO
MINIO_ACCESS_KEY=tcp-access-key
MINIO_SECRET_KEY=tcp-secret-key

# OIDC (bundled Zitadel). Real client credentials are generated into
# .env.testing.local; the placeholders below only satisfy config validation.
OIDC_ISSUER_URL=http://localhost:8080
OIDC_CLIENT_ID=placeholder-overridden-by-env-testing-local
OIDC_CLIENT_SECRET=placeholder-overridden-by-env-testing-local

# Zitadel
ZITADEL_MASTERKEY=TestingMasterkey1234567890ABCDEF

# Zitadel's default password policy requires 8+ chars with upper/lower/digit/symbol.
ZITADEL_ADMIN_PASSWORD=Testing123!
TEST_USERNAME=test
TEST_PASSWORD=Testing123!

# Internal service-to-service auth (used by tcp-cli and other internal clients).
INTERNAL_API_KEY=integration-test-internal-key
