# Environment for test scripts that launch Docker services.
# Safe to commit — contains only test credentials, never production secrets.
# Used by: scripts/run-integration-tests.sh, run-e2e-tests.sh, run-smoke-tests.sh

DATABASE_URL=postgres://lcp:dev-password@localhost:5432/lcp
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
LCP_SERVER_URL=http://lcp-server:3000

POSTGRES_PASSWORD=dev-password
MINIO_ACCESS_KEY=lcp-access-key
MINIO_SECRET_KEY=lcp-secret-key
OIDC_ISSUER_URL=http://localhost:8080
OIDC_INTERNAL_ISSUER_URL=http://zitadel:8080
ZITADEL_MASTERKEY=TestingMasterkey1234567890ABCDEF
# Zitadel's default password policy requires 8+ chars with upper/lower/digit/symbol.
ZITADEL_ADMIN_PASSWORD=Testing123!
TEST_USERNAME=test
TEST_PASSWORD=Testing123!
# OIDC_CLIENT_ID/SECRET and TEST_CLIENT_ID/SECRET below are overwritten in
# place by start-deployment.sh with real values once bootstrapped — Zitadel
# generates client secrets server-side rather than accepting a caller-chosen
# one, so these placeholders only matter before the very first bootstrap.
INTERNAL_API_KEY=integration-test-internal-key

# Environment-level LLM fallback (optional — not set here; tests use explicit llmConfig or company llmDefault)
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_TIMEOUT_MS=1800000

# Environment-level embedding fallback (optional — not set here; tests seed an explicit
# company embeddingConfig pointed at stub-llm instead)
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# Agent loop resource limits (optional — defaults used in tests)
# AGENT_ITERATIONS=40
# AGENT_LOOP_TIMEOUT_MS=1800000
# Reminder rounds when a run ends without its required tool calls (default 2) before it is failed.
# AGENT_REQUIRED_TOOL_RETRIES=2
OIDC_CLIENT_ID=383043773602529285
OIDC_CLIENT_SECRET=gol8CCjNwhbP4Wqt6xrpubPhtkbJxxVVEobk1Ijct5Qq2Jij1sN1fUXQuDaupKMb
