{
  // Returned by describe_server — gives the agent an overview of available memory tools.
  "describe_server": "## Memory Service\n\nProvides semantic search over the role's knowledge base and episodic memory.\nAll searches use pgvector cosine similarity against the company embedding model.\n\n### Tools\n- **describe_server** — this overview\n- **recall(roleId, companyId, query, top_k?)** — search both episodic memory and knowledge base\n- **remember(roleId, companyId, content, agentId?, tags?)** — store an episodic memory entry\n- **search_knowledge(roleId, companyId, query, top_k?)** — search the role knowledge base only",

  // Returned when no embedding config is configured for the company.
  "no_embedding_config": "No embedding config found for this company — cannot perform semantic search.",

  // Returned by remember() when no embedding config is available.
  "no_embedding_config_store": "No embedding config found — memory stored without embedding (not searchable).",

  // Returned when a search returns no results above the similarity threshold.
  "no_results": "No results found above the similarity threshold.",

  // Returned by remember() on success. Use {{id}} as the placeholder for the memory UUID.
  "memory_stored": "Memory stored (id: {{id}})."
}
