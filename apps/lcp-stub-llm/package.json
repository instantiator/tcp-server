{
  "name": "lcp-stub-llm",
  "version": "0.1.0",
  "description": "Configurable stub LLM server for testing LLM/agentic systems — simulates a real provider's API with scripted prompt/response/tool-call behaviour.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --cache",
    "format": "prettier --write --list-different \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\"",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
