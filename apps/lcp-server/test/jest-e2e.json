{
  "rootDir": "../../..",
  "testMatch": ["<rootDir>/apps/lcp-server/test/*.e2e-spec.ts"],
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/apps/lcp-server/test/e2e-setup.ts"],
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "moduleNameMapper": {
    "@lcp/shared": "<rootDir>/libs/lcp-shared/src/index.ts",
    "^jwks-rsa$": "<rootDir>/apps/lcp-server/test/__mocks__/jwks-rsa.ts"
  }
}
