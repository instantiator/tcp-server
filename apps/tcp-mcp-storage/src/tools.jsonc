{
  // Tool descriptions for tcp-mcp-storage

  // Read-only exploration of shared storage.
  "describe_server": "Returns an overview of the storage service and its tools.",
  "describe_folder": "Explains the purpose of a folder in the storage hierarchy.",
  "list_files": "Lists files under a path prefix in the shared object store (read-only exploration).",
  "read_file": "Reads the text content of any file in the shared object store by its full key.",
  "search_files": "Lists files matching a glob pattern under a path prefix.",
  "get_file_properties": "Returns metadata for a file: size, content type, last modified, and whether it exists.",
  "get_file_summary": "Returns a structural summary of a file without reading its full content: headings, top-level keys, or top-level declarations depending on format.",

  // Assignment-scoped working files. You pass only a filename (subdirectories
  // allowed); it is placed in your own assignment's working directory.
  "list_working_files": "Lists the files in your assignment's working directory.",
  "get_working_file_properties": "Returns metadata (size, content type, last modified, existence) for a file in your working directory.",
  "get_working_file_summary": "Returns a structural summary of a file in your working directory without reading its full content: headings, top-level keys, or (for CSV) column names and row count, depending on format. Cheaper than read_working_file for checking a large or unfamiliar file's shape first.",
  "read_working_file": "Reads a file from your working directory by filename.",
  "create_working_file": "Creates a new file with the given content, or replaces one entirely when overwrite: true. Use this for a brand-new file or to rewrite a file from scratch; use append_working_file to add to a file and replace_in_working_file for a small in-place edit. Fails if the file exists and overwrite is not set.",
  "append_working_file": "Appends text to a file in your working directory, creating it if it does not exist. The resulting document is validated.",
  "replace_in_working_file": "Replaces every occurrence of a literal string in a working-directory file and reports the replacement count. Errors if the file is missing or the string is not found.",
  "delete_working_file": "Soft-deletes a file in your working directory. Reverse with restore_working_file.",
  "restore_working_file": "Restores a soft-deleted file in your working directory.",
  "rename_working_file": "Renames (moves) a file within your working directory, from one filename to another.",

  // Assignment materials (inputs handed to your assignment). Read-only.
  "list_material_files": "Lists the materials supplied to your assignment (uploaded files, prior outputs, and inline text).",
  "get_material_file_properties": "Returns metadata for one of your assignment's materials.",
  "read_material_file": "Reads one of your assignment's materials by name (returns the inline text directly for inline-text materials)."
}
