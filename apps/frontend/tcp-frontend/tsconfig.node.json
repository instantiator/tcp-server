{
  // Covers the build and test-runner configuration only. These run in Node and
  // need Node types; tsconfig.json (the browser project) sets `"types": []` on
  // purpose, so it cannot typecheck them and must not be widened to.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolvePackageJsonExports": true,
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "playwright.config.ts"]
}
