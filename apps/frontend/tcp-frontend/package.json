{
  "name": "tcp-frontend",
  "version": "0.0.1",
  "description": "The TCP web client: React, Vite, React Router and TanStack Query, with React Aria Components for behaviour.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noemit -p tsconfig.json && tsc --noemit -p src/tsconfig.json && tsc --noemit -p test/browser/tsconfig.json",
    "test": "npm run test:import-boundary && vitest run",
    "test:browser": "playwright test",
    "test:import-boundary": "eslint --no-ignore -f json test/fixtures/server-import-must-fail.ts | grep -q '\"ruleId\":\"no-restricted-imports\"'"
  },
  "dependencies": {
    "@react-aria/live-announcer": "^3.5.1",
    "@tanstack/react-query": "^5.101.4",
    "@tcp/shared": "^0.0.1",
    "lucide-react": "^1.48.0",
    "oidc-client-ts": "^3.5.0",
    "openapi-fetch": "^0.17.0",
    "phaser": "^4.2.1",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "react-oidc-context": "^3.3.1",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@guidepup/virtual-screen-reader": "^0.32.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.12.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
