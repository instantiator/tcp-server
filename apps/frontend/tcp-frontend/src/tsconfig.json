{
  // The browser application. It lives in `src/` rather than at the workspace
  // root so that an editor resolves it correctly: editors pick the *nearest*
  // `tsconfig.json` above a file and ignore any other name, so a config at the
  // root would also claim `vite.config.ts` and `playwright.config.ts` — which
  // run in Node and need the very types this project must not have.
  //
  // Each project therefore sits in the directory it governs:
  //   ../tsconfig.json            the root-level tooling configs (Node)
  //   ./tsconfig.json             this, the browser bundle
  //   ../test/browser/tsconfig.json  the Playwright specs (Node)
  //
  // This workspace does NOT extend tsconfig.base.json: that config enables
  // decorators and pulls in Node/Jest/multer types, none of which belong in a
  // bundle that runs in a browser (ADR-022).
  //
  // Note the `paths` block declares `@tcp/shared/client` and deliberately
  // omits the bare `@tcp/shared`. That alone does not block the server-only
  // export — @tcp/shared is a real workspace package, so Node resolution
  // finds it through node_modules regardless. The alias omission removes the
  // *convenient* route; the `no-restricted-imports` rule in this workspace's
  // eslint.config.mjs is what actually fails the edit, and Vite failing on
  // `typeorm` is the backstop.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolvePackageJsonExports": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "paths": {
      "@tcp/shared/client": ["../../../../libs/tcp-shared/src/client.ts"]
    },
    // Syntax support only, and not a licence to use decorators here.
    // `@tcp/shared` is consumed as source, not as built .d.ts files (ADR-022),
    // so `export type { TcpTask }` makes tsc parse TcpTask.model.ts — which
    // carries `@Entity`/`@Column`. Without this it fails with TS1240 on the
    // decorators. `emitDecoratorMetadata` stays off: that one has a runtime
    // cost, and nothing here emits. Browser safety comes from those exports
    // being `export type` (erased), not from this flag.
    "experimentalDecorators": true,
    // Empty on purpose. Adding "node" here — the fix an editor will suggest
    // when a root-level tooling file reports `process` as undefined — makes
    // `process`, `Buffer` and `fs` typecheck inside `src/`, quietly dissolving
    // the server/browser boundary ADR-022 exists to hold. Those files belong
    // to ../tsconfig.json instead.
    "types": [],
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  // Tests are colocated here, so this covers them too. `test/fixtures` holds
  // the deliberately-broken import-boundary fixture and belongs to no project
  // on purpose — see package.json's test:import-boundary.
  "include": ["**/*"]
}
