{
  "name": "tcp-backend",
  "version": "0.0.1",
  "description": "The NestJS services (API, agent runner, three MCP servers) and the tcp-cli.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run build:apps",
    "build:apps": "nest build tcp-server && nest build tcp-agent && nest build tcp-mcp-storage && nest build tcp-mcp-memory && nest build tcp-mcp-interactions && nest build tcp-mcp-tasks && nest build tcp-cli",
    "build:tcp-cli": "nest build tcp-cli",
    "start": "nest start tcp-server",
    "start:dev": "nest start tcp-server --watch",
    "start:debug": "nest start tcp-server --debug --watch",
    "start:prod": "node dist/apps/tcp-server/main",
    "start:tcp-cli": "node dist/apps/tcp-cli/main",
    "typecheck": "tsc --noemit -p apps/tcp-server/tsconfig.json && tsc --noemit -p apps/tcp-agent/tsconfig.json && tsc --noemit -p apps/tcp-cli/tsconfig.json && tsc --noemit -p apps/tcp-mcp-storage/tsconfig.json && tsc --noemit -p apps/tcp-mcp-memory/tsconfig.json && tsc --noemit -p apps/tcp-mcp-interactions/tsconfig.json && tsc --noemit -p apps/tcp-mcp-tasks/tsconfig.json && tsc --noemit -p test/tsconfig.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register ../../node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json",
    "test:integration": "jest --config test/jest-integration.json",
    "test:api": "jest --config test/jest-api.json",
    "test:smoke": "jest --config test/jest-smoke.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/openai": "^1.5.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "@tcp/shared": "*",
    "@types/terminal-kit": "^2.5.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.18.1",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^5.80.9",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.1",
    "fast-xml-parser": "^5.10.1",
    "inquirer": "^14.0.2",
    "ioredis": "^5.11.1",
    "joi": "^18.2.3",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "^5.2.1",
    "json5": "^2.2.3",
    "jwks-rsa": "^4.1.0",
    "mammoth": "^1.12.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pgvector": "^0.3.0",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "terminal-kit": "^3.1.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typeorm": "^1.1.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/inquirer": "^9.0.10",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/turndown": "^5.0.6",
    "jest": "^30.0.0",
    "jest-junit": "^17.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "verbose": true,
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "roots": [
      "<rootDir>/apps",
      "<rootDir>/test/support",
      "<rootDir>/../../libs/tcp-shared",
      "<rootDir>/../../scripts/setup-wizard"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.spec.json"
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(pgvector|commander)/)"
    ],
    "moduleNameMapper": {
      "^@tcp/shared/(.*)$": "<rootDir>/../../libs/tcp-shared/src/$1",
      "^@tcp/shared$": "<rootDir>/../../libs/tcp-shared/src/index.ts"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/test/unit-test-setup.ts"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "<rootDir>/../../coverage",
    "testEnvironment": "node",
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "<rootDir>/../../test-results",
          "outputName": "unit.xml"
        }
      ]
    ]
  }
}
