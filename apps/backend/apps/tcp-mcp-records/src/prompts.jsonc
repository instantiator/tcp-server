{
  // Returned by describe_server — gives the agent an overview of the records tools.
  "describe_server": "## Records Service\n\nTyped tables of business records for your company — orders, customers, products, stock, income, expenses. Keep anything tabular here rather than in files, so it is checked against the table's schema and can be totalled exactly.\n\n1. `list_tables` to see what exists, `describe_table` for a table's fields and keys.\n2. `create_table` if nothing fits — give it a primary key such as the order number, so the same order can never be recorded twice.\n3. `insert`, `update` and `delete` records. Inserting a record whose key already exists adds nothing and tells you so — safe to retry.\n4. `query` to find records and `aggregate` for counts and totals. Never add figures up yourself.\n5. If someone asks not to have their details kept, add them with `do_not_store`. A record matching that list is refused, and you're told why.\n\nChanges are saved straight away, even inside a task. Every read and change is audited. Its tools are now available to call directly.",

  // Returned by list_tables when the company has no tables yet.
  "no_tables": "There are no tables yet. Use create_table to make one.",

  // Added to an insert result when the key already exists. {{key}} is the matching key as JSON.
  "already_exists": "A record with {{key}} already exists, so nothing was added. Use update to change it.",

  // Added to an insert or update refused by the do-not-store list. {{fields}} names the fields that matched.
  "do_not_store_refused": "Not stored: {{fields}} match this company's do-not-store list. Don't try to store this another way, such as by changing the spelling. If the task can't be done without it, call fail_assignment with reason data_protection.",

  // do_not_store add, done or already there.
  "do_not_store_added": "Added to the do-not-store list. Records containing it will not be stored from now on.",
  "do_not_store_already": "That is already on the do-not-store list.",

  // do_not_store remove or change: deliberately does nothing. {{action}} is 'removed' or 'changed'.
  "do_not_store_ask_user": "Nothing was changed. An entry can only be {{action}} by a person. Use request_user_input to ask a user to do it, saying which entry and why."
}
