{
  // Tool descriptions for tcp-mcp-utilities
  "describe_server": "Returns an overview of the utilities service and its tools.",
  "calculate": "Work out an arithmetic expression exactly, with decimal maths. Use it for every sum involving money or quantities instead of calculating yourself. Supports + - * / ^ (whole-number powers), brackets, % as percent (120 * 20% = 24), and round(x, dp), round_even(x, dp), floor, ceil, abs, min, max. Write plain numbers without currency symbols or thousands separators. Round money yourself: round(3 * 4.99 * 1.2, 2) = 17.96.",
  "date_math": "Exact date calculations on YYYY-MM-DD dates. operation `add` / `subtract`: move `date` by years, months, weeks and days (31 Jan + 1 month = 28 Feb, flagged as clamped). `add_business_days`: move `date` by `days` working days (Monday to Friday, skipping any `holidays`). `difference`: calendar days and business days from `date` to `other_date`. `tax_year`: the tax year containing `date`, starting on `tax_year_start` (MM-DD, default 04-06, the UK tax year).",
  "convert_units": "Convert a weight or length exactly, for example to check a postage band. Weights: mg, g, kg, t, oz, lb, st. Lengths: mm, cm, m, km, in, ft, yd, mi. Give `value` as a plain decimal number, e.g. convert 2.5 lb to kg."
}
