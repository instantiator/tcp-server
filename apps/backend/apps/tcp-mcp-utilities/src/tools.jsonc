{
  // Tool descriptions for tcp-mcp-utilities. Every tool's schema is sent to the
  // model on every turn, so keep these short: small local models have 8k windows.
  "describe_server": "Overview of the utilities service.",
  "calculate": "Work out arithmetic exactly (decimal maths). Use it for every sum with money or quantities. + - * / ^, brackets, % as percent (120 * 20% = 24), round(x, dp), round_even, floor, ceil, abs, min, max. Plain numbers only, e.g. round(3 * 4.99 * 1.2, 2).",
  "date_math": "Exact maths on YYYY-MM-DD dates. add/subtract: move `date` by years, months, weeks, days. add_business_days: move by `days` weekdays, skipping `holidays`. difference: days and business days to `other_date`. tax_year: the tax year containing `date` (start `tax_year_start` MM-DD, default 04-06).",
  "convert_units": "Convert a weight (mg g kg t oz lb st) or length (mm cm m km in ft yd mi) exactly. `value` is a plain decimal."
}
