{
  // Returned by describe_server — gives the agent an overview of available interaction tools.
  "describe_server": "## Interactions Service\n\nEnables requesting input from users or consultation from other agents. Its tools are always available (not gated behind this description) since they're essential control-flow tools you may need at any point.\nTools that pause agent execution will not return until the request is fulfilled. If you raise more than one request before it resumes, it will only resume once every request has a response.\nTo complete your assignment, use the tasks service (not this one).",

  // Returned on successful user-input pause. {{slug}} is replaced with the conversation slug.
  "paused_user_input": "Paused. Your question has been submitted as conversation '{{slug}}'. Your task will resume automatically when a user responds.",

  // Returned when request_user_input fails.
  "error_user_input": "Could not submit user input request. Try again or proceed without user input.",

  // Returned on successful agent-consultation pause. {{roleName}} and {{consultationId}} are replaced.
  "paused_consultation": "Paused. Consultation request dispatched to '{{roleName}}' (id: {{consultationId}}). Your task will resume automatically when the consulting agent responds.",

  // Returned when request_agent_consultation fails. {{roleName}} is replaced (falls back to the roleId if no name was given).
  "error_consultation": "Could not dispatch consultation to '{{roleName}}'. Check the role id (from list_available_contacts) and try again.",

  // Returned when list_available_contacts fails to retrieve one of its collections.
  "error_list_users": "Could not retrieve user list.",
  "error_list_roles": "Could not retrieve role list."
}
