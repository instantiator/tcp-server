{
  // Tool descriptions for tcp-mcp-memory
  "describe_server": "Returns an overview of the memory service and its tools.",
  "recall": "Search both episodic memory and the knowledge base by semantic similarity. Phrase `query` as a natural-language question or descriptive sentence, not bare keywords — see its description.",
  "remember": "Store one short fact for future runs of your role: something learned, a user's preference, or a correction. Write a single sentence that makes sense on its own. Set `replaces` to a memory's id to correct it.",
  "search_knowledge": "Search the role knowledge base only by semantic similarity. Phrase `query` as a natural-language question or descriptive sentence, not bare keywords — see its description."
