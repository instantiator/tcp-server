{
  "verbose": true,
  "rootDir": "..",
  "setupFiles": [
    "<rootDir>/test/api/api-setup.ts"
  ],
  "testMatch": [
    "<rootDir>/test/api/*.spec.ts"
  ],
  "testEnvironment": "node",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.spec.json"
      }
    ]
  },
  "testTimeout": 60000,
  "reporters": [
    "default",
    [
      "jest-junit",
      {
        "outputDirectory": "<rootDir>/../../test-results",
        "outputName": "api.xml"
      }
    ]
  ],
  "transformIgnorePatterns": [
    "node_modules/(?!(pgvector)/)"
  ]
}
