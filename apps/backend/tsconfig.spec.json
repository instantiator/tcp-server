{
  // The config ts-jest compiles specs with.
  //
  // Jest's `roots` reach outside this workspace — `test/support`,
  // `libs/tcp-shared` and `scripts/setup-wizard` — so the common source
  // directory of everything ts-jest touches is the repository root, not
  // `apps/backend`. TypeScript 6 refuses to infer `rootDir` in that situation
  // and fails every suite with TS5011; 5.9 inferred one silently.
  //
  // It is deliberately NOT set on `tsconfig.json` itself. Every app's
  // `tsconfig.app.json` extends that file, and `rootDir` decides the shape of
  // `outDir` — moving it would relocate every built entrypoint under
  // `dist/apps/<app>/`, which the container images and the `start:prod`
  // scripts resolve by path.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    // ts-jest emits JavaScript for the runner, never type declarations.
    "declaration": false
  }
}
