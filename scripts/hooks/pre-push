#!/usr/bin/env bash
# Pre-push hook. Regenerating licenses/schema is pre-commit's job only (this
# hook never calls licenses:generate/schema:generate — see scripts/hooks/pre-commit) —
# doing it here too was a duplicate write that could produce spurious drift
# (e.g. registry-dependent fields) and fail the push over nothing already
# committed. This hook does:
#   1. typecheck, shellcheck, lint — defensive re-checks in case pre-commit
#      was bypassed or hooks were only just installed.
#   2. a compile-only build (npm run build:apps — no schema/license
#      regeneration) and an aislop scan.
#   3. A migration drift check, scoped to the commits being pushed.
#   4. The service-backed quality gate: unit, integration, and e2e tests.
# Install: npm run hooks:install
# Bypass: git push --no-verify
set -euo pipefail

TOP="$(git rev-parse --show-toplevel)"
cd "$TOP"

# First, because everything below inherits the invoking shell's Node and a
# mismatch surfaces as ~200 unrelated test failures rather than as itself.
bash "$TOP/scripts/check-node-version.sh"

echo "→ pre-push: typecheck..."
npm run typecheck --silent

echo "→ pre-push: shellcheck..."
npm run shellcheck --silent

# Verification only (no --fix) — by this point commits are already made, so
# the hook should confirm the committed state is clean rather than mutate an
# already-committed tree without amending it.
echo "→ pre-push: lint..."
npm run lint:check --silent

echo "→ pre-push: build..."
npm run build:apps --silent

echo "→ pre-push: aislop scan..."
npx --yes aislop@latest ci

# Migration drift check, scoped to the commits being pushed (no database needed).
# A full `migration:generate` drift check is not viable here: the models
# intentionally diverge from the Postgres migrations (varchar for UUID/date
# columns for SQLite cross-compat) and use pgvector types TypeORM can't
# introspect, so generate always reports phantom drift. Instead we flag only
# when THIS branch changes an entity model without also adding/editing a
# migration — which stops the check re-firing on every push after an unrelated
# model edit already on the remote. Run scripts/check-migrations.sh to inspect
# the full (phantom-inclusive) model-vs-migration diff by hand.
echo "→ pre-push: checking for migration drift..."
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
[[ -z "$upstream" ]] && upstream="origin/main"

if git rev-parse --verify --quiet "$upstream" >/dev/null; then
  changed=$(git diff --name-only "$upstream...HEAD")
  models_changed=$(echo "$changed" | grep -E 'libs/tcp-shared/src/models/.*\.model\.ts' || true)
  migrations_changed=$(echo "$changed" | grep -E 'apps/backend/apps/tcp-server/src/migrations/.*\.ts' || true)

  # A .model.ts file only implies schema when it actually declares a table or
  # column (@Entity/@Column). Pure interfaces/types whose values live inside a
  # jsonb column (e.g. AgentRunConfig, stored in runConfig) change no schema, so
  # exclude them to avoid false positives. Inspect the pushed (HEAD) version,
  # falling back to the pre-change version so a *deleted* entity still counts.
  entity_models=""
  if [[ -n "$models_changed" ]]; then
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      content=$(git show "HEAD:$f" 2>/dev/null || git show "$upstream:$f" 2>/dev/null || true)
      if grep -qE '@Entity|@Column' <<< "$content"; then
        entity_models+="$f"$'\n'
      fi
    done <<< "$models_changed"
  fi
  entity_models=${entity_models%$'\n'}

  if [[ -n "$entity_models" && -z "$migrations_changed" ]]; then
    echo ""
    echo "✗ pre-push: this branch changes entity models without a migration:"
    echo "    ${entity_models//$'\n'/$'\n'    }"
    echo ""
    echo "  If the schema changed, generate a migration before pushing:"
    echo "    npm run migration:generate -- apps/backend/apps/tcp-server/src/migrations/<Name>"
    echo ""
    echo "  If the change was non-structural (comments, validation decorators,"
    echo "  or a type-only refactor), bypass this check with:  git push --no-verify"
    echo ""
    exit 1
  fi
fi

# Quality gate: unit tests, then the service-backed tiers. Each wrapper starts
# and tears down its own containers; api/smoke need the full stack incl.
# Zitadel and belong in CI, not here.
echo "→ pre-push: running unit tests..."
bash "$TOP/scripts/run-unit-tests.sh"

if ! docker info >/dev/null 2>&1; then
  echo ""
  echo "✗ pre-push: Docker is not running — integration and e2e tests need it."
  echo "  Start Docker and retry, or (only if the change has no runtime surface)"
  echo "  bypass with:  git push --no-verify"
  echo ""
  exit 1
fi

echo "→ pre-push: running integration tests..."
bash "$TOP/scripts/run-integration-tests.sh"

echo "→ pre-push: running e2e tests..."
bash "$TOP/scripts/run-e2e-tests.sh"

echo "✓ pre-push checks passed."
