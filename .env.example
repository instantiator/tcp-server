# PostgreSQL
DATABASE_URL=postgres://tcp:dev-password@localhost:5432/tcp

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=tcp-access-key
MINIO_SECRET_KEY=tcp-secret-key
MINIO_BUCKET_PREFIX=tcp
# The console's browser URL — read by tcp-cli's open-document-store and
# written into the web app's runtime config for the archive tray's Silo
# links (docs/shared-storage.md).
MINIO_CONSOLE_URL=http://localhost:9001

# Knowledge RAG reindex reconciliation poller interval (ms). Default 60000.
KNOWLEDGE_POLL_INTERVAL_MS=60000

# OIDC — set OIDC_ISSUER_URL to your IdP's issuer URL.
# The Zitadel Docker Compose profile (docker compose --profile auth up) provides one at the URL below.
# OIDC_CLIENT_ID/SECRET are NOT set here: they are generated/provider-issued and
# live in the gitignored "<env-file>.local" override. When the Zitadel profile
# is active, start-deployment.sh writes the real, server-generated values there
# on first bootstrap; for an external provider, put your fixed values in .local.
# OIDC_WEB_CLIENT_ID is a third such value: the browser's public PKCE client.
OIDC_ISSUER_URL=http://localhost:8080

# Set true only for a provider whose ID token omits the profile/email claims,
# forcing the browser to fetch them from the userinfo endpoint instead.
# OIDC_LOAD_USER_INFO=false

# Administrators — comma-separated OIDC `sub` claims and/or email addresses.
# The only callers permitted to use `?all=true` on GET /api/company and the
# /api/system routes; everyone else reaches only companies they are a member of.
# Empty (the default) means nobody: forgetting to set it loses an administrative
# view rather than granting one. When the Zitadel profile is active,
# start-deployment.sh writes the bootstrapped human and machine user ids to the
# "<env-file>.local" override; for an external provider, set it here yourself.
# TCP_ADMIN_IDENTIFIERS=

# Zitadel (only used when running Zitadel via Docker Compose)
# Masterkey encrypting Zitadel's secrets at rest — must be exactly 32 characters.
ZITADEL_MASTERKEY=ChangeThisMasterkey1234567890ABC
# Password for the org admin (human) user created on first boot.
# Zitadel's default password policy requires 8+ chars with upper/lower/digit/symbol.
ZITADEL_ADMIN_PASSWORD=ChangeMe123!

# Human test user created by start-deployment.sh — used to manually exercise
# `tcp-cli get-token`'s device-authorization login flow.
TEST_USERNAME=test
TEST_PASSWORD=ChangeMe123!

# Machine test user (client_credentials) created by start-deployment.sh — used
# by the api test tier (test/api/helpers/ApiHelper.ts) to obtain tokens
# non-interactively, since device-flow login requires a human in a browser.
# TEST_CLIENT_ID/SECRET are generated by the bootstrap and written to the
# gitignored "<env-file>.local" override — not set here.

# Database
DB_USER=tcp
DB_PASSWORD=dev-password
DB_NAME=tcp

# Host ports. Each is independent, with its own default; none is derived from
# another. Change one when something else already uses it.
EXPOSE_PORT_API=3000
# EXPOSE_PORT_DB=5432
# EXPOSE_PORT_MINIO=9000
# EXPOSE_PORT_MINIO_CONSOLE=9001
# The bundled Zitadel always uses 8080: start-deployment.sh refuses any
# EXPOSE_PORT_ZITADEL other than 8080 while the auth profile is on.
# tcp-agent's host port, published only when the deployment is started with
# --dev-ports (the smoke tier reaches it directly). NOT 3001, its container
# port: .env.testing publishes tcp-server on the host's 3001.
EXPOSE_PORT_AGENT=3003
# nginx's HTTPS/HTTP2 port (tcp-web) — the address people and tests use to
# reach the web app.
EXPOSE_PORT_WEB=5173
# The Vite development server, plain HTTP. Only reached by nginx, and only
# when the stack is started with --dev-web (docker-compose.dev-web.yml).
EXPOSE_PORT_WEB_DEV=4173

# LLM provider API key masking
TCP_MASK_API_KEYS=true

# Internal service authentication (service-to-service calls; must match across all services)
INTERNAL_API_KEY=change-me-in-production

# Environment-level LLM fallback — checked last in the resolution chain (role → company → env → fail).
# LLM_PROVIDER and LLM_MODEL must both be set to activate the fallback; all other fields are optional.
# LLM_PROVIDER is a provider id from libs/tcp-shared/src/llm/provider-catalogue.ts: openai, anthropic,
# google, azure, amazon-bedrock, mistral, openrouter, lm-studio, ollama or openai-compatible.
# LLM_PROVIDER=lm-studio
# LLM_MODEL=google/gemma-4-e4b
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# LLM_API_KEY=<your-api-key>
# LLM_CONTEXT_WINDOW=8192
# Per-request timeout for LLM API calls in milliseconds. Default: 1800000 (30 min).
# LLM_TIMEOUT_MS=1800000

# Where a company's or role's llmConfig / embeddingConfig may send requests.
# Remote providers (openai, anthropic, ...) must use their own URL from the catalogue.
# Local and custom ones (lm-studio, ollama, openai-compatible) may only use a host
# listed here, or the host of LLM_BASE_URL / EMBEDDING_BASE_URL. Comma-separated.
# This stops a signed-in user making tcp-server call internal addresses.
# LLM_ALLOWED_HOSTS=host.docker.internal,gpu-box.lan

# Per-provider application-level token caps, as a JSON object keyed by provider id
# from libs/tcp-shared/src/llm/provider-catalogue.ts. Each cap can set several
# limits; "month"/"week"/"day" are UTC calendar periods, and "<N>h" (e.g. "5h")
# is a stint that starts at the provider's first use after the previous stint
# ended. notifyAt (default [80]) raises a warning notification at each listed
# percentage; reaching 100% always notifies. action (default "pause") is what
# happens when any limit is reached: "pause" pauses running agents before their
# next LLM call, "finish-agents" lets running agents finish but starts no new
# ones, and "finish-tasks" lets running tasks finish and only turns off the web
# UI's "start now" default. Chats, and tasks a user explicitly starts or resumes,
# are never held back.
# A cap can still be overshot by calls already in flight when it trips, so also
# set a hard spend limit in each provider's own console as the real backstop.
# SPEND_CAPS={"anthropic":{"limits":[{"tokens":2000000,"per":"5h"},{"tokens":20000000,"per":"week"}],"notifyAt":[50,80],"action":"pause"}}

# Environment-level embedding fallback — checked when a company has no embeddingConfig.
# The model must produce at most 2000 dimensions (the pgvector ivfflat index limit); set EMBEDDING_DIMENSION to match.
# EMBEDDING_PROVIDER and EMBEDDING_MODEL must both be set to activate the fallback.
# EMBEDDING_PROVIDER=lm-studio
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
# EMBEDDING_API_KEY=<your-api-key>

# Agent loop resource limits (optional — per-role and per-company runConfig takes precedence)
# Maximum LLM invocations per agent run before the run is cancelled as failed.
# Raise this for slow local models that burn turns on narration before acting.
# AGENT_ITERATIONS=40
# Parallel agent jobs the worker runs at once (default 1).
# AGENT_WORKER_CONCURRENCY=1
# Wall-clock timeout in milliseconds before the run is cancelled as failed.
# AGENT_LOOP_TIMEOUT_MS=1800000
# Reminder rounds when a run ends without its required tool calls (default 2) before it is failed.
# AGENT_REQUIRED_TOOL_RETRIES=2
