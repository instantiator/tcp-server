# PostgreSQL
DATABASE_URL=postgres://lcp:dev-password@localhost:5432/lcp

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=lcp-access-key
MINIO_SECRET_KEY=lcp-secret-key
MINIO_BUCKET_PREFIX=lcp

# OIDC — set OIDC_ISSUER_URL to your IdP's issuer URL.
# The Keycloak Docker Compose profile (docker compose --profile auth up) provides one at the URL below.
OIDC_ISSUER_URL=http://localhost:8080/realms/lcp
OIDC_CLIENT_ID=lcp-server
OIDC_CLIENT_SECRET=change-me

# Keycloak admin (only used when running Keycloak via Docker Compose)
KEYCLOAK_ADMIN_PASSWORD=admin

# PostgreSQL password (used by Docker Compose)
POSTGRES_PASSWORD=dev-password

# LLM provider API keys
# Set the env var name referenced in LcpRole.llmConfig.apiKeyEnvVar.
# The key name is stored in the role; the value must be in the environment — never in the database.
# LM Studio (local): set this to the bearer token configured in LM Studio settings
LM_STUDIO_API_KEY=your-lm-studio-token-here
# OpenAI (if used):
# OPENAI_API_KEY=sk-...

# Service ports (optional — defaults shown)
# LCP_SERVER_PORT=3000
# LCP_AGENT_PORT=3001
