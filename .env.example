# PostgreSQL
DATABASE_URL=postgres://lcp:dev-password@localhost:5432/lcp

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=lcp-access-key
MINIO_SECRET_KEY=lcp-secret-key
MINIO_BUCKET_PREFIX=lcp

# Knowledge RAG reindex reconciliation poller interval (ms). Default 60000.
KNOWLEDGE_POLL_INTERVAL_MS=60000

# OIDC — set OIDC_ISSUER_URL to your IdP's issuer URL.
# The Zitadel Docker Compose profile (docker compose --profile auth up) provides one at the URL below.
# OIDC_CLIENT_ID/SECRET are placeholders: when the Zitadel profile is active,
# start-deployment.sh overwrites them in place with the real, server-generated
# values on first bootstrap (Zitadel doesn't accept a caller-chosen secret).
OIDC_ISSUER_URL=http://localhost:8080
OIDC_CLIENT_ID=lcp-server
OIDC_CLIENT_SECRET=change-me

# Zitadel (only used when running Zitadel via Docker Compose)
# Masterkey encrypting Zitadel's secrets at rest — must be exactly 32 characters.
ZITADEL_MASTERKEY=ChangeThisMasterkey1234567890ABC
# Password for the org admin (human) user created on first boot.
# Zitadel's default password policy requires 8+ chars with upper/lower/digit/symbol.
ZITADEL_ADMIN_PASSWORD=ChangeMe123!

# Human test user created by start-deployment.sh — used to manually exercise
# `lcp-cli get-token`'s device-authorization login flow.
TEST_USERNAME=test
TEST_PASSWORD=ChangeMe123!

# Machine test user (client_credentials) created by start-deployment.sh — used
# by the api test tier (test/api/helpers/ApiHelper.ts) to obtain tokens
# non-interactively, since device-flow login requires a human in a browser.
TEST_CLIENT_ID=change-me
TEST_CLIENT_SECRET=change-me

# PostgreSQL password (used by Docker Compose)
POSTGRES_PASSWORD=dev-password

# LLM provider API key masking
# When true (the default), the apiKey field in LlmConfig is replaced with '***' in all API responses.
# Set to false to expose raw keys, e.g. during local debugging.
LCP_MASK_API_KEYS=true

# Internal service authentication (service-to-service calls; must match across all services)
INTERNAL_API_KEY=change-me-in-production
# URL that lcp-agent and MCP servers use to reach lcp-server (within Docker Compose network)
LCP_SERVER_URL=http://lcp-server:3000

# Service ports (optional — defaults shown)
# LCP_SERVER_PORT=3000
# LCP_AGENT_PORT=3001

# Environment-level LLM fallback — checked last in the resolution chain (role → company → env → fail).
# LLM_PROVIDER and LLM_MODEL must both be set to activate the fallback; all other fields are optional.
# LLM_PROVIDER=lm-studio
# LLM_MODEL=qwen/qwen3.5-9b
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# LLM_API_KEY=<your-api-key>
# LLM_CONTEXT_WINDOW=8192
# Per-request timeout for LLM API calls in milliseconds. Default: 1800000 (30 min).
# Raise this for slow local models that take longer than 30 min to respond.
# LLM_TIMEOUT_MS=1800000

# Environment-level embedding fallback — checked when a company has no embeddingConfig.
# EMBEDDING_PROVIDER and EMBEDDING_MODEL must both be set to activate the fallback.
# The model must output exactly 768-dimensional vectors — the knowledge_chunk/
# episodic_memory pgvector columns are a fixed vector(768). Check a model's
# actual output before configuring it: query its /v1/embeddings endpoint with
# any input and count the returned array's length — model cards can be wrong
# or out of date. A different dimension requires a new migration to change
# the column width (see ADR-004's amendment) and re-indexing every scope.
# EMBEDDING_PROVIDER=lm-studio
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v2-moe
# EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
# EMBEDDING_API_KEY=<your-api-key>

# Agent loop resource limits (optional — per-role and per-company runConfig takes precedence)
# Maximum LLM invocations per agent run before the run is cancelled as failed.
# Raise this for slow local models that burn turns on narration before acting.
# AGENT_ITERATIONS=40
# Parallel agent jobs the worker runs at once (default 5). Set to 1 when agents
# share one capacity-limited model (e.g. a single local LLM) so they don't
# starve each other of model time.
# AGENT_WORKER_CONCURRENCY=1
# Wall-clock timeout in milliseconds before the run is cancelled as failed.
# AGENT_LOOP_TIMEOUT_MS=1800000
# Reminder rounds when a run ends without its required tool calls (default 2) before it is failed.
# AGENT_REQUIRED_TOOL_RETRIES=2
