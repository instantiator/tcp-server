{
  "permissions": {
    "allow": ["Bash(*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/dev-qual/scripts/agent-hook.sh post-edit --scope project"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/dev-qual/scripts/agent-hook.sh session-start --scope project"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/dev-qual/scripts/agent-hook.sh stop --scope project"
          }
        ]
      }
    ]
  }
}
