{
  "permissions": {
    "allow": ["Bash(*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash dev-environment/scripts/check.sh --fast"
          }
        ]
      }
    ]
  }
}
