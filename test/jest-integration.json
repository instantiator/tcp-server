{
  "verbose": true,
  "rootDir": "..",
  "testMatch": [
    "<rootDir>/test/integration/**/*.integration-spec.ts"
  ],
  "testEnvironment": "node",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "transformIgnorePatterns": ["node_modules/(?!(pgvector)/)"],
  "moduleNameMapper": {
    "@tcp/shared": "<rootDir>/libs/lcp-shared/src/index.ts"
  },
  "globalSetup": "<rootDir>/test/integration/global-setup.ts",
  "globalTeardown": "<rootDir>/test/integration/global-teardown.ts",
  "testTimeout": 30000,
  "maxWorkers": 1,
  "reporters": [
    "default",
    ["jest-junit", { "outputDirectory": "test-results", "outputName": "integration.xml" }]
  ]
}
