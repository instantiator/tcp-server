{
  "rootDir": "..",
  "testMatch": [
    "<rootDir>/apps/*/test/integration/*.integration-spec.ts"
  ],
  "testEnvironment": "node",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "moduleNameMapper": {
    "@lcp/shared": "<rootDir>/libs/lcp-shared/src/index.ts"
  },
  "testTimeout": 30000
}
