# Development mode: the same nginx image, but `location /` proxies to a Vite
# development server on the host instead of serving built files. Selected by
# 10-tcp-init.sh when WEB_UPSTREAM is set (docker-compose.dev-web.yml).
#
# This exists because Vite's development server cannot serve HTTP/2 — it has no
# HTTP/2 implementation, and `server.https` gives TLS over HTTP/1.1. Running the
# deployment's own proxy in front is the only way development gets the protocol
# ADR-025 requires, and it has the side benefit of giving development the same
# same-origin /api path as deployment.

server {
  # See static.conf.template for why this is HTTPS-only.
  listen 443 ssl;
  http2 on;
  ssl_certificate     /etc/nginx/certs/tls.crt;
  ssl_certificate_key /etc/nginx/certs/tls.key;

  root /usr/share/nginx/html;

  # Served from the image even in development — Vite knows nothing about it,
  # and the app needs the same runtime configuration either way.
  location = /config.js {
    add_header Cache-Control "no-store" always;
  }

  # Identical to static.conf.template's — see there for the reasoning.
  location /api/ {
    proxy_pass http://tcp-server:3000;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 24h;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Everything else is Vite's, including its own SPA fallback — so no
  # try_files here.
  location / {
    proxy_pass ${WEB_UPSTREAM};
    proxy_http_version 1.1;

    # Hot module replacement runs over a WebSocket. nginx does not implement
    # RFC 8441 (WebSockets over HTTP/2), so the browser opens a separate
    # HTTP/1.1 connection for it — these headers are what that connection
    # needs to be upgraded and passed through.
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection "upgrade";

    # Vite streams module transforms as it makes them; buffering would batch
    # them into a slow first paint.
    proxy_buffering off;
    proxy_read_timeout 24h;

    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
