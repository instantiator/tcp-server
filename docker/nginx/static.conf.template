# Deployment mode: nginx serves the built bundle and reverse-proxies /api to
# tcp-server, so the browser sees one origin (ADR-029). Selected by
# 10-tcp-init.sh when WEB_UPSTREAM is unset.

server {
  # HTTPS only. HTTP/2 is a hard requirement (ADR-025: five or more
  # simultaneous event streams is an ordinary working state, and HTTP/1.1 caps
  # a browser at six per origin), and no browser negotiates HTTP/2 without TLS
  # — there is no cleartext h2c in Chrome, Firefox or Safari. So TLS is not a
  # production-hardening choice here; it is what makes HTTP/2 exist at all.
  #
  # The certificate is self-signed by default, generated at container start.
  # Mount a real one (mkcert locally) over /etc/nginx/certs to remove the
  # browser warning — see docs/web-client.md.
  listen 443 ssl;
  http2 on;
  ssl_certificate     /etc/nginx/certs/tls.crt;
  ssl_certificate_key /etc/nginx/certs/tls.key;

  root /usr/share/nginx/html;

  # Runtime configuration, written by 10-tcp-init.sh from the container's
  # environment. Never cached: a config.js held over from another environment
  # points the app at the wrong identity provider, and the resulting sign-in
  # failure carries no hint of its own cause.
  location = /config.js {
    add_header Cache-Control "no-store" always;
  }

  # Vite content-hashes everything under assets/, so a changed file is a
  # changed name and the cached copy can never be stale.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  # The API. tcp-server's controllers already carry an `api/` route prefix
  # (@Controller('api/company') and friends), so this passes the path through
  # unchanged — no trailing slash on proxy_pass, no rewrite.
  location /api/ {
    proxy_pass http://tcp-server:3000;
    proxy_http_version 1.1;

    # Server-Sent Events die behind a buffering proxy: nginx would hold each
    # event until its buffer filled, which in a live view is indistinguishable
    # from the server having stopped sending. Off for every /api response —
    # the streaming endpoints are mixed in with the ordinary ones
    # (@Sse(':id/events') on the company, task and agent controllers).
    proxy_buffering off;
    proxy_cache off;
    # A stream is idle whenever nothing is happening, which is most of the
    # time. The default 60s would drop it as dead.
    proxy_read_timeout 24h;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Deep links. React Router owns any path that is not a file and not /api;
  # without this, loading /company/acme directly returns 404 — a fault that
  # only ever appears on refresh, never during in-app navigation.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
