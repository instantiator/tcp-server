# compiled output — unanchored: each workspace builds into its own dist/
# (apps/backend/dist), not a single root one.
dist
/build

# Unanchored: most dependencies hoist to the root, but npm still nests a few
# per workspace wherever a version cannot be shared — and tcp-stub-llm, which
# is not a workspace at all, has its own tree.
node_modules

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output
/test-results
# Playwright writes its HTML report next to its config, not at the repo root.
# Its traces and screenshots go to /test-results, above (see `outputDir` in
# apps/frontend/tcp-frontend/playwright.config.ts).
playwright-report

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# ESLint cache
.eslintcache

# IDE - VSCode
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.dev
# Per-instance secret overrides (generated Zitadel creds, external OIDC creds):
# every committed <env-file> has a gitignored <env-file>.local sibling applied
# on top of it. See docs/prompts/010.8.4 - config resolution plan.md.
.env*.local
# Temp env file written by run-api-tests.sh (trap-cleaned, but ignore for safety).
.env.run

# temp directory
.temp
.tmp
temp/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Zitadel bootstrap machine-user PAT (generated on first boot; see docker-compose.yml)
/docker/zitadel-machinekey/*
!/docker/zitadel-machinekey/.gitkeep

# TLS certificate for tcp-web, if one is supplied rather than self-signed at
# container start. Machine-local by definition — a mkcert certificate is only
# trusted by the machine whose CA signed it (see docs/web-client.md).
/docker/nginx/certs/
