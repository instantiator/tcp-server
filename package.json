{
  "name": "tcp-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "workspaces": ["apps/backend", "apps/frontend/tcp-frontend", "libs/tcp-shared"],
  "scripts": {
    "build": "npm run build --workspaces --if-present && npm run schema:generate && npm run licenses:generate",
    "build:apps": "npm run build:apps --workspace apps/backend",
    "build:tcp-cli": "npm run build:tcp-cli --workspace apps/backend",
    "start": "npm run start --workspace apps/backend",
    "start:dev": "npm run start:dev --workspace apps/backend",
    "start:debug": "npm run start:debug --workspace apps/backend",
    "start:prod": "npm run start:prod --workspace apps/backend",
    "start:tcp-cli": "npm run start:tcp-cli --workspace apps/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write --list-different \"apps/**/*.ts\" \"libs/**/*.ts\" \"docs/**/*.md\" \"*.md\" \"apps/**/*.jsonc\"",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint \"{apps,libs}/**/*.ts\" \"apps/**/*.jsonc\" --fix --cache",
    "lint:check": "NODE_OPTIONS=--max-old-space-size=4096 eslint \"{apps,libs}/**/*.ts\" \"apps/**/*.jsonc\" --cache",
    "test": "npm test --workspaces --if-present",
    "test:all": "./scripts/run-all-tests.sh",
    "test:e2e": "npm run test:e2e --workspace apps/backend",
    "test:integration": "npm run test:integration --workspace apps/backend",
    "test:api": "npm run test:api --workspace apps/backend",
    "test:smoke": "npm run test:smoke --workspace apps/backend",
    "schema:generate": "ts-json-schema-generator --path 'libs/tcp-shared/src/models/*.ts' --type '*' --out schemas/schema.json",
    "shellcheck": "shellcheck $(find . -name '*.sh' -not -path './node_modules/*' -not -path './.git/*') scripts/hooks/pre-commit scripts/hooks/pre-push",
    "licenses:generate": "license-report --config=.license-report.json --output=markdown --only=prod --package=apps/backend/package.json --exclude=@tcp/shared > docs/licenses.md",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d apps/backend/apps/tcp-server/src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d apps/backend/apps/tcp-server/src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d apps/backend/apps/tcp-server/src/data-source.ts",
    "hooks:install": "cp scripts/hooks/pre-commit scripts/hooks/pre-push .git/hooks/ && chmod +x .git/hooks/pre-commit .git/hooks/pre-push && echo 'Git hooks installed.'",
    "setup": "tsx scripts/setup-wizard/index.ts",
    "setup:build": "tsc -p scripts/setup-wizard/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jsonc": "^3.3.0",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.7.0",
    "license-report": "^6.8.5",
    "prettier": "^3.9.5",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "multer": "^2.2.0",
    "@nestjs/swagger": {
      "js-yaml": "4.3.0"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.0"
    },
    "brace-expansion": "^5.0.8"
  }
}
