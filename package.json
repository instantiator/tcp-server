{
  "name": "lcp-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build lcp-server && nest build lcp-agent && npm run schema:generate && npm run licenses:generate",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start lcp-server",
    "start:dev": "nest start lcp-server --watch",
    "start:debug": "nest start lcp-server --debug --watch",
    "start:prod": "node dist/apps/lcp-server/main",
    "typecheck": "tsc --noemit -p apps/lcp-server/tsconfig.app.json && tsc --noemit -p apps/lcp-agent/tsconfig.app.json && tsc --noemit -p libs/lcp-shared/tsconfig.lib.json",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/lcp-server/test/jest-e2e.json",
    "test:integration": "jest --config test/jest-integration.json --forceExit",
    "test:system": "jest --config test/jest-system.json",
    "schema:generate": "ts-json-schema-generator --path 'libs/lcp-shared/src/models/*.ts' --type '*' --out schemas/schema.json",
    "licenses:generate": "license-report --config=.license-report.json --output=markdown --only=prod > docs/licenses.md",
    "migration:generate": "typeorm migration:generate -d apps/lcp-server/src/data-source.ts",
    "migration:run": "typeorm migration:run -d apps/lcp-server/src/data-source.ts",
    "migration:revert": "typeorm migration:revert -d apps/lcp-server/src/data-source.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.1",
    "axios": "^1.18.0",
    "better-sqlite3": "^12.10.0",
    "joi": "^18.2.3",
    "jwks-rsa": "^4.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "license-report": "^6.8.5",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-json-schema-generator": "^2.9.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "multer": "^2.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "roots": [
      "<rootDir>/apps",
      "<rootDir>/libs"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "@lcp/shared": "<rootDir>/libs/lcp-shared/src/index.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
