{
  // Compiler options shared by every Node-side workspace: the backend apps,
  // libs/tcp-shared, and scripts/setup-wizard. Deliberately NOT named
  // tsconfig.json — a root tsconfig.json would be picked up as the default
  // project by editors and by any config that omits `extends`, which is
  // exactly how the browser workspace would silently inherit Node types and
  // decorator support it must not have (ADR-022).
  //
  // The `@tcp/shared` path aliases live in each consumer's own config, since
  // the relative depth to libs/tcp-shared differs per workspace.
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "@types/jest", "multer"]
  }
}
