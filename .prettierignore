# What Prettier must NOT touch. Everything else in the repository is fair game:
# `npm run format` and `format:check` run against `.`, so this file — plus
# `.gitignore`, which Prettier also reads — is the whole of the exclusion list.
#
# That direction matters. An allowlist of paths in package.json silently skips
# every directory and file type nobody remembered to add to it, and gives no
# signal that it has happened. `scripts/setup-wizard` went unformatted and
# unlinted that way for its whole life.

# tcp-stub-llm is a standalone app with its own .prettierrc — format it via
# its own `npm run format`, not the root one.
apps/tcp-stub-llm

# The dev-environment submodule is a separate repository with its own tooling.
# Formatting it here would produce a diff this repo cannot commit.
dev-environment

# Generated artefacts. Their generator's output is authoritative; reformatting
# them means the gate fails after every build that regenerates them.
docs/licenses.md
.license-report.json
schemas/schema.json
apps/frontend/tcp-frontend/src/api/schema.d.ts
