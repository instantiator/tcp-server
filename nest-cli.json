{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/lcp-server",
  "sourceRoot": "apps/lcp-server/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "projects": {
    "lcp-server": {
      "type": "application",
      "root": "apps/lcp-server",
      "entryFile": "main",
      "sourceRoot": "apps/lcp-server/src",
      "compilerOptions": {
        "tsConfigPath": "apps/lcp-server/tsconfig.app.json"
      }
    },
    "lcp-agent": {
      "type": "application",
      "root": "apps/lcp-agent",
      "entryFile": "main",
      "sourceRoot": "apps/lcp-agent/src",
      "compilerOptions": {
        "tsConfigPath": "apps/lcp-agent/tsconfig.app.json",
        "assets": [{ "include": "prompts.jsonc", "outDir": "dist/apps/lcp-agent" }]
      }
    },
    "lcp-shared": {
      "type": "library",
      "root": "libs/lcp-shared",
      "entryFile": "index",
      "sourceRoot": "libs/lcp-shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/lcp-shared/tsconfig.lib.json"
      }
    },
    "lcp-cli": {
      "type": "application",
      "root": "apps/lcp-cli",
      "entryFile": "main",
      "sourceRoot": "apps/lcp-cli/src",
      "compilerOptions": {
        "tsConfigPath": "apps/lcp-cli/tsconfig.app.json"
      }
    },
    "lcp-mcp-storage": {
      "type": "application",
      "root": "apps/lcp-mcp-storage",
      "entryFile": "main",
      "sourceRoot": "apps/lcp-mcp-storage/src",
      "compilerOptions": {
        "tsConfigPath": "apps/lcp-mcp-storage/tsconfig.app.json",
        "assets": [{ "include": "prompts.jsonc", "outDir": "dist/apps/lcp-mcp-storage" }]
      }
    },
    "lcp-mcp-memory": {
      "type": "application",
      "root": "apps/lcp-mcp-memory",
      "entryFile": "main",
      "sourceRoot": "apps/lcp-mcp-memory/src",
      "compilerOptions": {
        "tsConfigPath": "apps/lcp-mcp-memory/tsconfig.app.json",
        "assets": [{ "include": "prompts.jsonc", "outDir": "dist/apps/lcp-mcp-memory" }]
      }
    },
    "lcp-mcp-interactions": {
      "type": "application",
      "root": "apps/lcp-mcp-interactions",
      "entryFile": "main",
      "sourceRoot": "apps/lcp-mcp-interactions/src",
      "compilerOptions": {
        "tsConfigPath": "apps/lcp-mcp-interactions/tsconfig.app.json",
        "assets": [{ "include": "prompts.jsonc", "outDir": "dist/apps/lcp-mcp-interactions" }]
      }
    }
  }
}
