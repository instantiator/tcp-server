        "slug": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "slug",
        "name"
      ],
      "type": "object"
    },
    "TcpCompany": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "minLength": 1,
